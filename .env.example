# ---------------------------------------------------------------------------
# DronaHQ Agents
# ---------------------------------------------------------------------------
# Each agent is a published DronaHQ agent with a Webhook Trigger attached.
# Copy this file to `.env.local` and fill in the values. `.env*` is gitignored.
#
# In the DronaHQ console, per agent:
#   URL -> Agents > <agent> > Triggers > Webhook > "Webhook URL"
#   KEY -> same panel, "Generate API Key" (shown once — copy it then)
#
# The agent MUST be published. An unpublished agent returns HTTP 500
# "this agent's data hasn't been published or is unavailable".
#
# Any agent left blank runs simulated. The sidebar shows how many are wired,
# and every activity event is labelled with what actually produced it.

# Workspace key, used for any agent without its own key.
DRONAHQ_API_KEY=

# ICP Fitment Agent — scores and qualifies or rejects a prospect
DRONAHQ_AGENT_QUALIFY_URL=
DRONAHQ_AGENT_QUALIFY_KEY=

# Lead Research Agent — builds the structured prospect brief
DRONAHQ_AGENT_RESEARCH_URL=
DRONAHQ_AGENT_RESEARCH_KEY=

# Outreach Strategy Agent — decides whether, when and on which channel
DRONAHQ_AGENT_OUTREACH_URL=
DRONAHQ_AGENT_OUTREACH_KEY=

# Personalisation Agent — writes the outreach message
DRONAHQ_AGENT_PERSONALISE_URL=
DRONAHQ_AGENT_PERSONALISE_KEY=

# Conversation Agent — reads replies, decides the next action
DRONAHQ_AGENT_CONVERSE_URL=
DRONAHQ_AGENT_CONVERSE_KEY=

# Follow-up Agent — decides when and how to follow up, or when to stop
DRONAHQ_AGENT_FOLLOWUP_URL=
DRONAHQ_AGENT_FOLLOWUP_KEY=

# The Voice SDR Agent is intentionally not wired in this build.
