# ---------------------------------------------------------------------------
# DronaHQ Agents
# ---------------------------------------------------------------------------
# Each agent is a published DronaHQ agent with a Webhook Trigger attached.
# Copy this file to `.env.local` and fill in the values. `.env*` is gitignored.
#
# Where these come from, in the DronaHQ console:
#   URL  -> Agents > <your agent> > Triggers > Webhook > "Webhook URL"
#   KEY  -> the same panel, "Generate API Key" (shown once — copy it then)
#
# Any agent left blank stays in simulated mode. The app shows which agents are
# live on the Integrations panel, so the UI never claims more than is wired.

# One workspace key used for every agent, if you generated a single key.
# Per-agent keys below override this.
DRONAHQ_API_KEY=

# --- ICP Fitment Agent: scores and qualifies or rejects a prospect ---
DRONAHQ_ICP_FITMENT_URL=
DRONAHQ_ICP_FITMENT_KEY=

# --- Lead Research Agent: builds the structured prospect brief ---
DRONAHQ_RESEARCH_URL=
DRONAHQ_RESEARCH_KEY=

# --- Outreach Strategy Agent: decides whether, when and on which channel ---
DRONAHQ_OUTREACH_STRATEGY_URL=
DRONAHQ_OUTREACH_STRATEGY_KEY=

# --- Personalisation Agent: writes the actual outreach message ---
DRONAHQ_PERSONALISATION_URL=
DRONAHQ_PERSONALISATION_KEY=

# --- Conversation Agent: reads replies, decides the next action ---
DRONAHQ_CONVERSATION_URL=
DRONAHQ_CONVERSATION_KEY=

# --- Follow-up Agent: decides when and how to follow up, or when to stop ---
DRONAHQ_FOLLOWUP_URL=
DRONAHQ_FOLLOWUP_KEY=

# The Voice SDR Agent is intentionally not wired in this build.
